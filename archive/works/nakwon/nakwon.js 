const qs = (s, el = document) => el.querySelector(s);
const qsa = (s, el = document) => Array.from(el.querySelectorAll(s));

function setYear(){
  const y = new Date().getFullYear();
  const a = qs("#year");
  const b = qs("#year2");
  if(a) a.textContent = String(y);
  if(b) b.textContent = String(y);
}

function navToggle(){
  const btn = qs("#navToggle");
  const panel = qs("#navPanel");
  if(!btn || !panel) return;

  btn.addEventListener("click", () => {
    const isOpen = panel.classList.toggle("open");
    btn.setAttribute("aria-expanded", String(isOpen));
  });

  qsa(".navLink", panel).forEach(link => {
    link.addEventListener("click", () => {
      panel.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    });
  });

  document.addEventListener("click", (e) => {
    const target = e.target;
    const clickedInside = panel.contains(target) || btn.contains(target);
    if(!clickedInside){
      panel.classList.remove("open");
      btn.setAttribute("aria-expanded", "false");
    }
  });
}

function revealOnScroll(){
  const els = qsa(".reveal");
  if(!("IntersectionObserver" in window)){
    els.forEach(el => el.classList.add("on"));
    return;
  }
  const io = new IntersectionObserver((entries) => {
    entries.forEach(ent => {
      if(ent.isIntersecting){
        ent.target.classList.add("on");
        io.unobserve(ent.target);
      }
    });
  }, { threshold: 0.12 });
  els.forEach(el => io.observe(el));
}

function toast(msg){
  const el = qs("#toast");
  if(!el) return;
  el.textContent = msg;
  el.classList.add("show");
  window.clearTimeout(toast._t);
  toast._t = window.setTimeout(() => el.classList.remove("show"), 1600);
}

async function copyText(text){
  try{
    await navigator.clipboard.writeText(text);
    toast("복사 완료");
  }catch{
    toast("복사 실패");
  }
}

function linkCopyButtons(){
  qsa("[data-copylink]").forEach(btn => {
    btn.addEventListener("click", () => {
      const hash = btn.getAttribute("data-copylink") || "#top";
      const url = new URL(window.location.href);
      url.hash = hash;
      copyText(url.toString());
    });
  });
}

function backToTop(){
  const btn = qs("#backToTop");
  if(!btn) return;
  btn.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
}

function contactLink(){
  const a = qs("#contactLink");
  if(a) a.href = DATA.contactUrl;
}

function makePublicationSlides(){
  const track = qs("#pubTrack");
  if(!track) return;

  track.innerHTML = "";
  DATA.publicationSlides.forEach((s, idx) => {
    const slide = document.createElement("article");
    slide.className = "slide";
    slide.tabIndex = 0;

    const img = document.createElement("img");
    img.className = "slideImg";
    img.alt = s.title || `slide ${idx + 1}`;
    img.src = s.src;
    img.loading = "lazy";
    img.addEventListener("click", () => openLightbox(s.src, s.caption || s.title || ""));

    const body = document.createElement("div");
    body.className = "slideBody";

    const t = document.createElement("h4");
    t.className = "slideTitle";
    t.textContent = s.title || "Untitled";

    const c = document.createElement("p");
    c.className = "slideCap";
    c.textContent = s.caption || "";

    body.appendChild(t);
    body.appendChild(c);

    slide.appendChild(img);
    slide.appendChild(body);
    track.appendChild(slide);
  });

  initCarousel(track);
}

function initCarousel(track){
  const prev = qs("#pubPrev");
  const next = qs("#pubNext");
  if(!prev || !next) return;

  let index = 0;
  const slideWidth = () => {
    const first = track.firstElementChild;
    if(!first) return 320;
    const rect = first.getBoundingClientRect();
    return rect.width + 12;
  };

  const update = () => {
    const w = slideWidth();
    track.style.transform = `translateX(${(-index * w)}px)`;
  };

  const maxIndex = () => Math.max(0, track.children.length - 1);

  prev.addEventListener("click", () => {
    index = Math.max(0, index - 1);
    update();
  });
  next.addEventListener("click", () => {
    index = Math.min(maxIndex(), index + 1);
    update();
  });

  window.addEventListener("resize", update);
  update();
}

function makePosterGrid(){
  const grid = qs("#posterGrid");
  if(!grid) return;
  grid.innerHTML = "";

  DATA.posters.forEach((p, idx) => {
    const tile = document.createElement("div");
    tile.className = "tile";
    tile.tabIndex = 0;

    const img = document.createElement("img");
    img.alt = p.caption || `poster ${idx + 1}`;
    img.src = p.src;
    img.loading = "lazy";

    const cap = document.createElement("div");
    cap.className = "cap";
    cap.textContent = p.caption || "";

    tile.appendChild(img);
    tile.appendChild(cap);

    tile.addEventListener("click", () => openLightbox(p.src, p.caption || ""));
    tile.addEventListener("keydown", (e) => {
      if(e.key === "Enter" || e.key === " "){
        e.preventDefault();
        openLightbox(p.src, p.caption || "");
      }
    });

    grid.appendChild(tile);
  });
}

function makePhotoGrid(){
  const grid = qs("#photoGrid");
  if(!grid) return;
  grid.innerHTML = "";

  DATA.photos.forEach((p, idx) => {
    const item = document.createElement("div");
    item.className = "mItem";
    item.tabIndex = 0;

    const img = document.createElement("img");
    img.alt = p.caption || `photo ${idx + 1}`;
    img.src = p.src;
    img.loading = "lazy";

    const cap = document.createElement("div");
    cap.className = "cap";
    cap.textContent = p.caption || "";

    item.appendChild(img);
    item.appendChild(cap);

    item.addEventListener("click", () => openLightbox(p.src, p.caption || ""));
    item.addEventListener("keydown", (e) => {
      if(e.key === "Enter" || e.key === " "){
        e.preventDefault();
        openLightbox(p.src, p.caption || "");
      }
    });

    grid.appendChild(item);
  });
}

function lightbox(){
  const box = qs("#lightbox");
  const close = qs("#lightboxClose");
  if(!box || !close) return;

  close.addEventListener("click", closeLightbox);
  box.addEventListener("click", (e) => {
    if(e.target === box) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if(e.key === "Escape") closeLightbox();
  });
}

function openLightbox(src, caption){
  const box = qs("#lightbox");
  const img = qs("#lightboxImg");
  const cap = qs("#lightboxCap");
  if(!box || !img || !cap) return;

  img.src = src;
  img.alt = caption || "";
  cap.textContent = caption || "";

  box.classList.add("open");
  box.setAttribute("aria-hidden", "false");
}

function closeLightbox(){
  const box = qs("#lightbox");
  const img = qs("#lightboxImg");
  const cap = qs("#lightboxCap");
  if(!box || !img || !cap) return;

  box.classList.remove("open");
  box.setAttribute("aria-hidden", "true");

  img.src = "";
  img.alt = "";
  cap.textContent = "";
}

function init(){
  setYear();
  navToggle();
  revealOnScroll();
  linkCopyButtons();
  backToTop();
  contactLink();

  makePublicationSlides();
  makePosterGrid();
  makePhotoGrid();
  lightbox();
}

document.addEventListener("DOMContentLoaded", init);
